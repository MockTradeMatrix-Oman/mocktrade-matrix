# Keep the repository's line endings stable across Windows and Linux so the
# Docker image built on Render is byte-identical to what runs locally.
* text=auto

*.sh            text eol=lf
Dockerfile      text eol=lf
*.mjs           text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
