# Required in production. server.mjs refuses to start without a unique value.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Optional. Only set to false when testing a production build over plain HTTP
# on localhost. Real deployments must serve HTTPS and leave this unset.
# COOKIE_SECURE=false

# Optional Firebase overrides for Google sign-in. The defaults in
# lib/firebase.ts point at the matrix-cf52e project. NEXT_PUBLIC_* values are
# baked into the client bundle at build time, so pass them as Docker build
# args (or set them before `npm run build`) if you use another project.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. Location of the SQLite file (default ./data).
# DATA_DIR=/tmp/mtm

# Optional. Only needed on hosts with an ephemeral disk (Render free, Koyeb,
# Cloud Run). The database is restored from this object at boot and re-uploaded
# on a timer and on shutdown. Leave unset when the disk is persistent.
# See lib/backup.mjs and the "Free hosting" section of DEPLOY.md.
# BACKUP_URL=https://<project-ref>.supabase.co/storage/v1/object/backups/mocktrade.db
# BACKUP_TOKEN=
# BACKUP_APIKEY=
# BACKUP_INTERVAL_MS=300000

# Guardian consent email for learners under 18. On Render free, SMTP ports are
# blocked, so use Brevo's HTTPS API (free, 300/day, no card). Verify the sender
# address in Brevo first, then set BREVO_API_KEY. Resend needs a domain.
# APP_URL=https://your-public-url
# BREVO_API_KEY=
# RESEND_API_KEY=
# MAIL_FROM="MockTrade Matrix <mocktradematrix@gmail.com>"
# MAIL_REPLY_TO=mocktradematrix@gmail.com
#
# SMTP fallback (local or a paid host only):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=mocktradematrix@gmail.com
# SMTP_PASS=
